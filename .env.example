# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored.

# Anthropic API key — required only for `charter issue` (projection step).
# Fetching, verifying, and aggregating verdicts requires no API key.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Anthropic model used by the projection step.
CHARTER_MODEL=claude-sonnet-4-6

# Public base URL where Charters are hosted. Used by `charter issue` to
# compute the published charter_url. Default is the local dev host; in
# production, set this to the publicly reachable HTTPS origin.
CHARTER_URL_BASE=http://localhost:8000

# Local data directory for Charter JSON files and Ed25519 issuer keys.
CHARTER_DATA_DIR=./data

# --- Qwen Cloud (Alibaba Cloud DashScope / Model Studio) -------------------
# For the CFO Office showcase running on Qwen instead of Anthropic. The adapter
# (charter/adapters/qwen.py) already defaults to the real Alibaba Cloud endpoint,
# so switching to Qwen Cloud is purely configuration. NEVER commit a real key.

# Your Alibaba Cloud Model Studio (Bailian) API key.
DASHSCOPE_API_KEY=sk-your-model-studio-key

# Use the LLM-driven (generative) path. Unset / anything else => deterministic,
# keyless stub path (reproducible, no API calls).
CHARTER_LLM_PROVIDER=qwen

# Model on DashScope: qwen-max (default) | qwen-plus | qwen-turbo | qwen3-max
CHARTER_QWEN_MODEL=qwen-max

# Endpoint. LEAVE UNSET to use the real Alibaba Cloud endpoint
# (https://dashscope.aliyuncs.com/compatible-mode/v1). Outside mainland China use
# the `-intl` host. Only set this to point at a non-Alibaba OpenAI-compatible gateway.
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
